ey, value),\n  removeItem: (key: string) => SecureStore.deleteItemAsync(key),\n};\n\nexport const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {\n  auth: {\n    storage: ExpoSecureStoreAdapter,\n    autoRefreshToken: true,\n    persistSession: true,\n    detectSessionInUrl: false,\n  },\n});\n","numLines":20,"startLine":1,"totalLines":20}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FJqebZiN7wH54rovFLrF8D","type":"tool_result","content":"     1→import { OPENAI_API_KEY } from '@/constants/config';\n     2→\n     3→const BASE_URL = 'https://api.openai.com/v1';\n     4→\n     5→async function openaiRequest<T>(endpoint: string, body: Record<string, unknown>): Promise<T> {\n     6→  if (!OPENAI_API_KEY) {\n     7→    throw new Error('OpenAI API key not configured');\n     8→  }\n     9→\n    10→  const response = await fetch(`${BASE_URL}${endpoint}`, {\n    11→    method: 'POST',\n    12→    headers: {\n    13→      Authorization: `Bearer ${OPENAI_API_KEY}`,\n    14→      'Content-Type': 'application/json',\n    15→    },\n    16→    body: JSON.stringify(body),\n    17→  });\n    18→\n    19→  if (!response.ok) {\n    20→    const err = await response.json().catch(() => ({ error: { message: response.statusText } }));\n    21→    throw new Error(err.error?.message || `OpenAI error: ${response.status}`);\n    22→  }\n    23→\n    24→  return response.json();\n    25→}\n    26→\n    27→export type LetterTone = 'warm' | 'professional' | 'casual' | 'formal' | 'heartfelt';\n    28→export type LetterOccasion =\n    29→  | 'thank_you'\n    30→  | 'birthday'\n    31→  | 'congratulations'\n    32→  | 'thinking_of_you'\n    33→  | 'sympathy'\n    34→  | 'holiday'\n    35→  | 'business'\n    36→  | 'custom';\n    37→\n    38→export interface GenerateLetterParams {\n    39→  occasion: LetterOccasion;\n    40→  tone: LetterTone;\n    41→  keyPoints?: string;\n    42→  recipientContext?: string;\n    43→  senderName?: string;\n    44→}\n    45→\n    46→export async function generateLetter(params: GenerateLetterParams): Promise<string[]> {\n    47→  const systemPrompt = `You are a skilled letter writer. Generate 3 variations of a handwritten-style letter.\n    48→Each letter should be warm, genuine, and appropriate for the occasion.\n    49→Return ONLY a JSON array of 3 strings, each being a complete letter.`;\n    50→\n    51→  const userPrompt = `Write 3 ${params.tone} letters for the occasion: ${params.occasion}.\n    52→${params.keyPoints ? `Key points to include: ${params.keyPoints}` : ''}\n    53→${params.recipientContext ? `Recipient context: ${params.recipientContext}` : ''}\n    54→${params.senderName ? `Sign as: ${params.senderName}` : ''}`;\n    55→\n    56→  const data = await openaiRequest<{\n    57→    choices: Array<{ message: { content: string } }>;\n    58→  }>('/chat/completions', {\n    59→    model: 'gpt-4o',\n    60→    messages: [\n    61→      { role: 'system', content: systemPrompt },\n    62→      { role: 'user', content: userPrompt },\n    63→    ],\n    64→    temperature: 0.8,\n    65→    max_tokens: 2000,\n    66→  });\n    67→\n    68→  const content = data.choices[0]?.message?.content || '[]';\n    69→  try {\n    70→    return JSON.parse(content);\n    71→  } catch {\n    72→    return [content];\n    73→  }\n    74→}\n    75→\n    76→export async function generateImages(prompt: string, n = 4): Promise<string[]> {\n    77→  const data = await openaiRequest<{\n    78→    data: Array<{ url: string }>;\n    79→  }>('/images/generations', {\n    80→    model: 'dall-e-3',\n    81→    prompt: `Beautiful card/letter front image: ${prompt}. Artistic, warm, suitable for physical mail.`,\n    82→    n: Math.min(n, 4),\n    83→    size: '1024x1024',\n    84→    quality: 'standard',\n    85→  });\n    86→\n    87→  return data.data.map((img) => img.url);\n    88→}\n    89→\n    90→export async function transcribeAudio(audioUri: string): Promise<string> {\n    91→  if (!OPENAI_API_KEY) {\n    92→    throw new Error('OpenAI API key not configured');\n    93→  }\n    94→\n    95→  const formData = new FormData();\n    96→\n    97→  const fileInfo = audioUri.split('/').pop() || 'recording.m4a';\n    98→  formData.append('file', {\n    99→    uri: audioUri,\n   100→    type: 'audio/m4a',\n   101→    name: fileInfo,\n   102→  } as unknown as Blob);\n   103→  formData.append('model', 'whisper-1');\n   104→  formData.append('language', 'en');\n   105→\n   106→  const response = await fetch(`${BASE_URL}/audio/transcriptions`, {\n   107→    method: 'POST',\n   108→    headers: {\n   109→      Authorization: `Bearer ${OPENAI_API_KEY}`,\n   110→    },\n   111→    body: formData,\n   112→  });\n   113→\n   114→  if (!response.ok) {\n   115→    throw new Error(`Transcription failed: ${response.statusText}`);\n   116→  }\n   117→\n   118→  const data = await response.json();\n   119→  return data.text;\n   120→}\n   121→\n   122→export async function extractAddress(text: string): Promise<{\n   123→  name: string;\n   124→  address: string;\n   125→  address2?: string;\n   126→  city: string;\n   127→  province: string;\n   128→  postal_code: string;\n   129→  country: string;\n   130→}> {\n   131→  const data = await openaiRequest<{\n   132→    choices: Array<{ message: { content: string } }>;\n   133→  }>('/chat/completions', {\n   134→    model: 'gpt-4o',\n   135→    messages: [\n   136→      {\n   137→        role: 'system',\n   138→        content:\n   139→          'Extract a structured US mailing address from the text. Return JSON with: name, address, address2 (optional), city, province (state abbreviation), postal_code, country. Return ONLY valid JSON.',\n   140→      },\n   141→      { role: 'user', content: text },\n   142→    ],\n   143→    temperature: 0,\n   144→    max_tokens: 300,\n   145→  });\n   146→\n   147→  return JSON.parse(data.choices[0]?.message?.content || '{}');\n   148→}\n   149→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01Ext1m4Q8w3CZiXCCd5Jh2i","session_id":"4dd7b65f-b41a-4d36-961b-3254f3a5b35c","uuid":"d847f628-6bc8-49cb-a169-5b5a4a0288c3","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/KindLetters/ios/services/openai.ts","content":"import { OPENAI_API_KEY } from '@/constants/config';\n\nconst BASE_URL = 'https://api.openai.com/v1';\n\nasync function openaiRequest<T>(endpoint: string, body: Record<string, unknown>): Promise<T> {\n  if (!OPENAI_API_KEY) {\n    throw new Error('OpenAI API key not configured');\n  }\n\n  const response = await fetch(`${BASE_URL}${endpoint}`, {\n    method: 'POST',\n    headers: {\n      Authorization: `Bearer ${OPENAI_API_KEY}`,\n      'Content-Type': 'application/json',\n    },\n    body: JSON.stringify(body),\n  });\n\n  if (!response.ok) {\n    const err = await response.json().catch(() => ({ error: { message: response.statusText } }));\n    throw new Error(err.error?.message || `OpenAI error: ${response.status}`);\n  }\n\n  return response.json();\n}\n\nexport type LetterTone = 'warm' | 'professional' | 'casual' | 'formal' | 'heartfelt';\nexport type LetterOccasion =\n  | 'thank_you'\n  | 'birthday'\n  | 'congratulations'\n  | 'thinking_of_you'\n  | 'sympathy'\n  | 'holiday'\n  | 'business'\n  | 'custom';\n\nexport interface GenerateLetterParams {\n  occasion: LetterOccasion;\n  tone: LetterTone;\n  keyPoints?: string;\n  recipientContext?: string;\n  senderName?: string;\n}\n\nexport async function generateLetter(params: GenerateLetterParams): Promise<string[]> {\n  const systemPrompt = `You are a skilled letter writer. Generate 3 variations of a handwritten-style letter.\nEach letter should be warm, genuine, and appropriate for the occasion.\nReturn ONLY a JSON array of 3 strings, each being a complete letter.`;\n\n  const userPrompt = `Write 3 ${params.tone} letters for the occasion: ${params.occasion}.\n${params.keyPoints ? `Key points to include: ${params.keyPoints}` : ''}\n${params.recipientContext ? `Recipient context: ${params.recipientContext}` : ''}\n${params.senderName ? `Sign as: ${params.senderName}` : ''}`;\n\n  const data = await openaiRequest<{\n    choices: Array<{ message: { content: string } }>;\n  }>('/chat/completions', {\n    model: 'gpt-4o',\n    messages: [\n      { role: 'system', content: systemPrompt },\n      { role: 'user', content: userPrompt },\n    ],\n    temperature: 0.8,\n    max_tokens: 2000,\n  });\n\n  const content = data.choices[0]?.message?.content || '[]';\n  try {\n    return JSON.parse(content);\n  } catch {\n    return [content];\n  }\n}\n\nexport async function generateImages(prompt: string, n = 4): Promise<string[]> {\n  const data = await openaiRequest<{\n    data: Array<{ url: string }>;\n  }>('/images/generations', {\n    model: 'dall-e-3',\n    prompt: `Beautiful card/letter front image: ${prompt}. Artistic, warm, suitable for physical mail.`,\n    n: Math.min(n, 4),\n    size: '1024x1024',\n    quality: 'standard',\n  });\n\n  return data.data.map((img) => img.url);\n}\n\nexport async function transcribeAudio(audioUri: string): Promise<string> {\n  if (!OPENAI_API_KEY) {\n    throw new Error('OpenAI API key not configured');\n  }\n\n  const formData = new FormData();\n\n  const fileInfo = audioUri.split('/').pop() || 'recording.m4a';\n  formData.append('file', {\n    uri: audioUri,\n    type: 'audio/m4a',\n    name: fileInfo,\n  } as unknown as Blob);\n  formData.append('model', 'whisper-1');\n  formData.append('language', 'en');\n\n  const response = await fetch(`${BASE_URL}/audio/transcriptions`, {\n    method: 'POST',\n    headers: {\n      Authorization: `Bearer ${OPENAI_API_KEY}`,\n    },\n    body: formData,\n  });\n\n  if (!response.ok) {\n    throw new Error(`Transcription failed: ${response.statusText}`);\n  }\n\n  const data = await response.json();\n  return data.text;\n}\n\nexport async function extractAddress(text: string): Promise<{\n  name: string;\n  address: string;\n  address2?: string;\n  city: string;\n  province: string;\n  postal_code: string;\n  country: string;\n}> {\n  const data = await openaiRequest<{\n    choices: Array<{ message: { content: string } }>;\n  }>('/chat/completions', {\n    model: 'gpt-4o',\n    messages: [\n      {\n        role: 'system',\n        content:\n          'Extract a structured US mailing address from the text. Return JSON with: name, address, address2 (optional), city, province (state abbreviation), postal_code, country. Return ONLY valid JSON.',\n      },\n      { role: 'user', content: text },\n    ],\n    temperature: 0,\n    max_tokens: 300,\n  });\n\n  return JSON.parse(data.choices[0]?.message?.content || '{}');\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PMbEcgT2nLAbSGMvopS6tF","type":"tool_result","content":"     1→import { THANKS_IO_API_KEY } from '@/constants/config';\n     2→\n     3→const BASE_URL = 'https://api.thanks.io/api/v2';\n     4→\n     5→export type ProductType = 'postcard' | 'letter' | 'greeting' | 'windowless_letter' | 'giftcard';\n     6→export type PostcardSize = '4x6' | '6x9' | '6x11';\n     7→export type HandwritingColor = 'blue' | 'black' | 'green' | 'purple' | 'red' | string;\n     8→\n     9→export interface HandwritingStyle {\n    10→  id: string;\n    11→  name: string;\n    12→  style: string;\n    13→}\n    14→\n    15→export interface Recipient {\n    16→  name: string;\n    17→  address: string;\n    18→  address2?: string;\n    19→  city: string;\n    20→  province: string;\n    21→  postal_code: string;\n    22→  country?: string;\n    23→  email?: string;\n    24→  phone?: string;\n    25→}\n    26→\n    27→export interface ThanksIoResponse {\n    28→  id: string;\n    29→  status: 'queued' | 'processing' | 'sent' | 'failed';\n    30→  created_at?: string;\n    31→  error?: string;\n    32→}\n    33→\n    34→export interface ThanksIoOrderStatus {\n    35→  id: string;\n    36→  status: 'queued' | 'processing' | 'sent' | 'delivered' | 'failed';\n    37→  created_at?: string;\n    38→  updated_at?: string;\n    39→  delivered_at?: string;\n    40→  estimated_delivery?: string;\n    41→  tracking_number?: string;\n    42→  error?: string;\n    43→}\n    44→\n    45→export interface ProductInfo {\n    46→  id: ProductType;\n    47→  name: string;\n    48→  description: string;\n    49→  basePrice: number;\n    50→  features: string[];\n    51→  allowedTiers: ('free' | 'pro' | 'business')[];\n    52→}\n    53→\n    54→// -------------------------------------------------------------------\n    55→// API helpers\n    56→// -------------------------------------------------------------------\n    57→\n    58→async function apiRequest<T>(\n    59→  method: 'GET' | 'POST',\n    60→  endpoint: string,\n    61→  body?: Record<string, unknown>,\n    62→): Promise<T> {\n    63→  if (!THANKS_IO_API_KEY) {\n    64→    throw new Error('Thanks.io API key not configured');\n    65→  }\n    66→\n    67→  const response = await fetch(`${BASE_URL}${endpoint}`, {\n    68→    method,\n    69→    headers: {\n    70→      Authorization: `Bearer ${THANKS_IO_API_KEY}`,\n    71→      'Content-Type': 'application/json',\n    72→    },\n    73→    ...(body ? { body: JSON.stringify(body) } : {}),\n    74→  });\n    75→\n    76→  if (!response.ok) {\n    77→    const err = await response.json().catch(() => ({ error: response.statusText }));\n    78→    throw new Error(err.error || `Thanks.io API error: ${response.status}`);\n    79→  }\n    80→\n    81→  return response.json();\n    82→}\n    83→\n    84→// -------------------------------------------------------------------\n    85→// Handwriting styles\n    86→// -------------------------------------------------------------------\n    87→\n    88→export async function getHandwritingStyles(): Promise<HandwritingStyle[]> {\n    89→  const data = await apiRequest<{ data: Array<{ id?: number; handwriting_id?: number; name?: string; description?: string; style?: string }> }>('GET', '/handwriting');\n    90→  return (\n    91→    data.data?.map((s) => ({\n    92→      id: String(s.id ?? s.handwriting_id ?? ''),\n    93→      name: s.name || `Style ${s.id ?? s.handwriting_id ?? 'unknown'}`,\n    94→      style: s.description || s.style || 'Handwritten',\n    95→    })) ?? []\n    96→  );\n    97→}\n    98→\n    99→// -------------------------------------------------------------------\n   100→// Order status\n   101→// -------------------------------------------------------------------\n   102→\n   103→export async function getOrderStatus(orderId: string): Promise<ThanksIoOrderStatus> {\n   104→  return apiRequest<ThanksIoOrderStatus>('GET', `/order/${orderId}`);\n   105→}\n   106→\n   107→// -------------------------------------------------------------------\n   108→// Send functions\n   109→// -------------------------------------------------------------------\n   110→\n   111→export async function sendPostcard(params: {\n   112→  recipients: Recipient[];\n   113→  message: string;\n   114→  handwriting_style?: string;\n   115→  handwriting_color?: HandwritingColor;\n   116→  front_image_url?: string;\n   117→  size?: PostcardSize;\n   118→}): Promise<ThanksIoResponse> {\n   119→  return apiRequest<ThanksIoResponse>('POST', '/postcard/send', {\n   120→    recipients: params.recipients,\n   121→    message: params.message,\n   122→    front_image_url: params.front_image_url,\n   123→    handwriting_style: params.handwriting_style || '1',\n   124→    handwriting_color: params.handwriting_color || 'blue',\n   125→    size: params.size || '4x6',\n   126→  });\n   127→}\n   128→\n   129→export async function sendLetter(params: {\n   130→  recipients: Recipient[];\n   131→  message: string;\n   132→  handwriting_style?: string;\n   133→  handwriting_color?: HandwritingColor;\n   134→  front_image_url?: string;\n   135→  pages?: number;\n   136→}): Promise<ThanksIoResponse> {\n   137→  return apiRequest<ThanksIoResponse>('POST', '/letter/send', {\n   138→    recipients: params.recipients,\n   139→    message: params.message,\n   140→    front_image_url: params.front_image_url,\n   141→    handwriting_style: params.handwriting_style || '1',\n   142→    handwriting_color: params.handwriting_color || 'blue',\n   143→    pages: params.pages || 1,\n   144→  });\n   145→}\n   146→\n   147→export async function sendGreetingCard(params: {\n   148→  recipients: Recipient[];\n   149→  message: string;\n   150→  handwriting_style?: string;\n   151→  handwriting_color?: HandwritingColor;\n   152→  front_image_url?: string;\n   153→  envelope_style?: string;\n   154→}): Promise<ThanksIoResponse> {\n   155→  return apiRequest<ThanksIoResponse>('POST', '/greeting/send', {\n   156→    recipients: params.recipients,\n   157→    message: params.message,\n   158→    front_image_url: params.front_image_url,\n   159→    handwriting_style: params.handwriting_style || '1',\n   160→    handwriting_color: params.handwriting_color || 'blue',\n   161→    envelope_style: params.envelope_style,\n   162→  });\n   163→}\n   164→\n   165→export async function sendWindowlessLetter(params: {\n   166→  recipients: Recipient[];\n   167→  pdf_url: string;\n   168→  front_image_url?: string;\n   169→  handwriting_style?: string;\n   170→}): Promise<ThanksIoResponse> {\n   171→  return apiRequest<ThanksIoResponse>('POST', '/send/windowlessletter', {\n   172→    recipients: params.recipients,\n   173→    pdf_url: params.pdf_url,\n   174→    front_image_url: params.front_image_url,\n   175→    handwriting_style: params.handwriting_style || '1',\n   176→  });\n   177→}\n   178→\n   179→// -------------------------------------------------------------------\n   180→// Product catalog (mirrors web version)\n   181→// -------------------------------------------------------------------\n   182→\n   183→export const PRODUCT_CATALOG: Record<ProductType, ProductInfo> = {\n   184→  postcard: {\n   185→    id: 'postcard',\n   186→    name: 'Postcard',\n   187→    description: 'Quick, cost-effective promotional mailer',\n   188→    basePrice: 1.14,\n   189→    features: ['3 sizes available', 'Front image customization', 'Handwritten message'],\n   190→    allowedTiers: ['free', 'pro', 'business'],\n   191→  },\n   192→  letter: {\n   193→    id: 'letter',\n   194→    name: 'Letter (Windowed)',\n   195→    description: 'Standard business letter with window envelope',\n   196→    basePrice: 1.20,\n   197→    features: ['Additional pages $0.20 each', 'Optional letterhead', 'Professional presentation'],\n   198→    allowedTiers: ['pro', 'business'],\n   199→  },\n   200→  greeting: {\n   201→    id: 'greeting',\n   202→    name: 'Greeting Card',\n   203→    description: 'Premium card with real stamp and handwritten address',\n   204→    basePrice: 3.00,\n   205→    features: ['Real stamp', 'Handwritten address', 'Premium envelope'],\n   206→    allowedTiers: ['pro', 'business'],\n   207→  },\n   208→  windowless_letter: {\n   209→    id: 'windowless_letter',\n   210→    name: 'Windowless Letter',\n   211→    description: 'Premium letter with PDF support and real stamp',\n   212→    basePrice: 2.52,\n   213→    features: ['PDF content support', 'Handwritten address', 'Real stamp'],\n   214→    allowedTiers: ['business'],\n   215→  },\n   216→  giftcard: {\n   217→    id: 'giftcard',\n   218→    name: 'Gift Card',\n   219→    description: 'Letter with physical gift card inclusion',\n   220→    basePrice: 3.00,\n   221→    features: ['Physical gift card', 'Multiple brands', 'US only'],\n   222→    allowedTiers: ['business'],\n   223→  },\n   224→};\n   225→\n   226→export function getPostcardPrice(size: PostcardSize): number {\n   227→  const prices: Record<PostcardSize, number> = { '4x6': 1.14, '6x9': 1.61, '6x11': 1.83 };\n   228→  return prices[size];\n   229→}\n   230→\n   231→export function getProductsForTier(tier: 'free' | 'pro' | 'business'): ProductInfo[] {\n   232→  return Object.values(PRODUCT_CATALOG).filter((p) => p.allowedTiers.includes(tier));\n   233→}\n   234→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01Ext1m4Q8w3CZiXCCd5Jh2i","session_id":"4dd7b65f-b41a-4d36-961b-3254f3a5b35c","uuid":"3a864243-1a97-4bd2-9e83-2d5605f9a6ea","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/KindLetters/ios/services/thanks-io.ts","content":"import { THANKS_IO_API_KEY } from '@/constants/config';\n\nconst BASE_URL = 'https://api.thanks.io/api/v2';\n\nexport type ProductType = 'postcard' | 'letter' | 'greeting' | 'windowless_letter' | 'giftcard';\nexport type PostcardSize = '4x6' | '6x9' | '6x11';\nexport type HandwritingColor = 'blue' | 'black' | 'green' | 'purple' | 'red' | string;\n\nexport interface HandwritingStyle {\n  id: string;\n  name: string;\n  style: string;\n}\n\nexport interface Recipient {\n  name: string;\n  address: string;\n  address2?: string;\n  city: string;\n  province: string;\n  postal_code: string;\n  country?: string;\n  email?: string;\n  phone?: string;\n}\n\nexport interface ThanksIoResponse {\n  id: string;\n  status: 'queued' | 'processing' | 'sent' | 'failed';\n  created_at?: string;\n  error?: string;\n}\n\nexport interface ThanksIoOrderStatus {\n  id: string;\n  status: 'queued' | 'processing' | 'sent' | 'delivered' | 'failed';\n  created_at?: string;\n  updated_at?: string;\n  delivered_at?: string;\n  estimated_delivery?: string;\n  tracking_number?: string;\n  error?: string;\n}\n\nexport interface ProductInfo {\n  id: ProductType;\n  name: string;\n  description: string;\n  basePrice: number;\n  features: string[];\n  allowedTiers: ('free' | 'pro' | 'business')[];\n}\n\n// -------------------------------------------------------------------\n// API helpers\n// -------------------------------------------------------------------\n\nasync function apiRequest<T>(\n  method: 'GET' | 'POST',\n  endpoint: string,\n  body?: Record<string, unknown>,\n): Promise<T> {\n  if (!THANKS_IO_API_KEY) {\n    throw new Error('Thanks.io API key not configured');\n  }\n\n  const response = await fetch(`${BASE_URL}${endpoint}`, {\n    method,\n    headers: {\n      Authorization: `Bearer ${THANKS_IO_API_KEY}`,\n      'Content-Type': 'application/json',\n    },\n    ...(body ? { body: JSON.stringify(body) } : {}),\n  });\n\n  if (!response.ok) {\n    const err = await response.json().catch(() => ({ error: response.statusText }));\n    throw new Error(err.error || `Thanks.io API error: ${response.status}`);\n  }\n\n  return response.json();\n}\n\n// -------------------------------------------------------------------\n// Handwriting styles\n// -------------------------------------------------------------------\n\nexport async function getHandwritingStyles(): Promise<HandwritingStyle[]> {\n  const data = await apiRequest<{ data: Array<{ id?: number; handwriting_id?: number; name?: string; description?: string; style?: string }> }>('GET', '/handwriting');\n  return (\n    data.data?.map((s) => ({\n      id: String(s.id ?? s.handwriting_id ?? ''),\n      name: s.name || `Style ${s.id ?? s.handwriting_id ?? 'unknown'}`,\n      style: s.description || s.style || 'Handwritten',\n    })) ?? []\n  );\n}\n\n// -------------------------------------------------------------------\n// Order status\n// -------------------------------------------------------------------\n\nexport async function getOrderStatus(orderId: string): Promise<ThanksIoOrderStatus> {\n  return apiRequest<ThanksIoOrderStatus>('GET', `/order/${orderId}`);\n}\n\n// -------------------------------------------------------------------\n// Send functions\n// -------------------------------------------------------------------\n\nexport async function sendPostcard(params: {\n  recipients: Recipient[];\n  message: string;\n  handwriting_style?: string;\n  handwriting_color?: HandwritingColor;\n  front_image_url?: string;\n  size?: PostcardSize;\n}): Promise<ThanksIoResponse> {\n  return apiRequest<ThanksIoResponse>('POST', '/postcard/send', {\n    recipients: params.recipients,\n    message: params.message,\n    front_image_url: params.front_image_url,\n    handwriting_style: params.handwriting_style || '1',\n    handwriting_color: params.handwriting_color || 'blue',\n    size: params.size || '4x6',\n  });\n}\n\nexport async function sendLetter(params: {\n  recipients: Recipient[];\n  message: string;\n  handwriting_style?: string;\n  handwriting_color?: HandwritingColor;\n  front_image_url?: string;\n  pages?: number;\n}): Promise<ThanksIoResponse> {\n  return apiRequest<ThanksIoResponse>('POST', '/letter/send', {\n    recipients: params.recipients,\n    message: params.message,\n    front_image_url: params.front_image_url,\n    handwriting_style: params.handwriting_style || '1',\n    handwriting_color: params.handwriting_color || 'blue',\n    pages: params.pages || 1,\n  });\n}\n\nexport async function sendGreetingCard(params: {\n  recipients: Recipient[];\n  message: string;\n  handwriting_style?: string;\n  handwriting_color?: HandwritingColor;\n  front_image_url?: string;\n  envelope_style?: string;\n}): Promise<ThanksIoResponse> {\n  return apiRequest<ThanksIoResponse>('POST', '/greeting/send', {\n    recipients: params.recipients,\n    message: params.message,\n    front_image_url: params.front_image_url,\n    handwriting_style: params.handwriting_style || '1',\n    handwriting_color: params.handwriting_color || 'blue',\n    envelope_style: params.envelope_style,\n  });\n}\n\nexport async function sendWindowlessLetter(params: {\n  recipients: Recipient[];\n  pdf_url: string;\n  front_image_url?: string;\n  handwriting_style?: string;\n}): Promise<ThanksIoResponse> {\n  return apiRequest<ThanksIoResponse>('POST', '/send/windowlessletter', {\n    recipients: params.recipients,\n    pdf_url: params.pdf_url,\n    front_image_url: params.front_image_url,\n    handwriting_style: params.handwriting_style || '1',\n  });\n}\n\n// -------------------------------------------------------------------\n// Product catalog (mirrors web version)\n// -------------------------------------------------------------------\n\nexport const PRODUCT_CATALOG: Record<ProductType, ProductInfo> = {\n  postcard: {\n    id: 'postcard',\n    name: 'Postcard',\n    description: 'Quick, cost-effective promotional mailer',\n    basePrice: 1.14,\n    features: ['3 sizes available', 'Front image customization', 'Handwritten message'],\n    allowedTiers: ['free', 'pro', 'business'],\n  },\n  letter: {\n    id: 'letter',\n    name: 'Letter (Windowed)',\n    description: 'Standard business letter with window envelope',\n    basePrice: 1.20,\n    features: ['Additional pages $0.20 each', 'Optional letterhead', 'Professional presentation'],\n    allowedTiers: ['pro', 'business'],\n  },\n  greeting: {\n    id: 'greeting',\n    name: 'Greeting Card',\n    description: 'Premium card with real stamp and handwritten address',\n    basePrice: 3.00,\n    features: ['Real stamp', 'Handwritten address', 'Premium envelope'],\n    allowedTiers: ['pro', 'business'],\n  },\n  windowless_letter: {\n    id: 'windowless_letter',\n    name: 'Windowless Letter',\n    description: 'Premium letter with PDF support and real stamp',\n    basePrice: 2.52,\n    features: ['PDF content support', 'Handwritten address', 'Real stamp'],\n    allowedTiers: ['business'],\n  },\n  giftcard: {\n    id: 'giftcard',\n    name: 'Gift Card',\n    description: 'Letter with physical gift card inclusion',\n    basePrice: 3.00,\n    features: ['Physical gift card', 'Multiple brands', 'US only'],\n    allowedTiers: ['business'],\n  },\n};\n\nexport function getPostcardPrice(size: PostcardSize): number {\n  const prices: Record<PostcardSize, number> = { '4x6': 1.14, '6x9': 1.61, '6x11': 1.83 };\n  return prices[size];\n}\n\nexport function getProductsForTier(tier: 'free' | 'pro' | 'business'): ProductInfo[] {\n  return Object.values(PRODUCT_CATALOG).filter((p) => p.allowedTiers.includes(tier));\n}\n","numLines":234,"startLine":1,"totalLines":234}}}
