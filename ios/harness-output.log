→    try {\n    46→      const status = await getOrderStatus(order.thanks_io_order_id);\n    47→      if (status) {\n    48→        setOrders((prev) =>\n    49→          prev.map((o) =>\n    50→            o.id === order.id ? { ...o, status: status.status } : o,\n    51→          ),\n    52→        );\n    53→      }\n    54→    } catch (error) {\n    55→      console.error('Failed to refresh order status:', error);\n    56→    }\n    57→  };\n    58→\n    59→  const formatDate = (dateStr: string) => {\n    60→    const d = new Date(dateStr);\n    61→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    62→  };\n    63→\n    64→  const s = StyleSheet.create({\n    65→    container: { flex: 1, backgroundColor: colors.background },\n    66→    card: { backgroundColor: colors.card, marginHorizontal: 16, marginBottom: 12, borderRadius: 12, padding: 16, borderWidth: 1, borderColor: colors.border },\n    67→    cardTop: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' },\n    68→    productType: { fontSize: 15, fontWeight: '600', color: colors.text, textTransform: 'capitalize' },\n    69→    statusBadge: { flexDirection: 'row', alignItems: 'center', gap: 4, paddingHorizontal: 8, paddingVertical: 3, borderRadius: 6 },\n    70→    statusText: { fontSize: 12, fontWeight: '600' },\n    71→    recipient: { fontSize: 15, color: colors.textSecondary, marginTop: 8 },\n    72→    preview: { fontSize: 14, color: colors.textMuted, marginTop: 4 },\n    73→    cardBottom: { flexDirection: 'row', justifyContent: 'space-between', marginTop: 10 },\n    74→    date: { fontSize: 13, color: colors.textMuted },\n    75→    cost: { fontSize: 14, fontWeight: '600', color: colors.primary },\n    76→    empty: { flex: 1, justifyContent: 'center', alignItems: 'center', padding: 40 },\n    77→    emptyText: { fontSize: 17, color: colors.textMuted, marginTop: 12, textAlign: 'center' },\n    78→    listContent: { paddingTop: 16, paddingBottom: 40 },\n    79→  });\n    80→\n    81→  if (isLoading) {\n    82→    return (\n    83→      <View style={[s.container, { justifyContent: 'center', alignItems: 'center' }]}>\n    84→        <ActivityIndicator size=\"large\" color={colors.primary} />\n    85→      </View>\n    86→    );\n    87→  }\n    88→\n    89→  return (\n    90→    <View style={s.container}>\n    91→      {orders.length === 0 ? (\n    92→        <View style={s.empty}>\n    93→          <ShoppingCart size={48} color={colors.textMuted} />\n    94→          <Text style={s.emptyText}>No orders yet.{'\\n'}Send your first letter to see it here.</Text>\n    95→        </View>\n    96→      ) : (\n    97→        <FlatList\n    98→          data={orders}\n    99→          keyExtractor={(item) => item.id}\n   100→          contentContainerStyle={s.listContent}\n   101→          refreshControl={\n   102→            <RefreshControl refreshing={refreshing} onRefresh={() => { setRefreshing(true); loadOrders(); }} />\n   103→          }\n   104→          renderItem={({ item }) => {\n   105→            const cfg = STATUS_CONFIG[item.status] || STATUS_CONFIG.queued;\n   106→            const Icon = cfg.icon;\n   107→            return (\n   108→              <TouchableOpacity style={s.card} onPress={() => refreshOrderStatus(item)}>\n   109→                <View style={s.cardTop}>\n   110→                  <Text style={s.productType}>{item.product_type.replace('_', ' ')}</Text>\n   111→                  <View style={[s.statusBadge, { backgroundColor: cfg.color + '20' }]}>\n   112→                    <Icon size={14} color={cfg.color} />\n   113→                    <Text style={[s.statusText, { color: cfg.color }]}>{cfg.label}</Text>\n   114→                  </View>\n   115→                </View>\n   116→                <Text style={s.recipient}>{item.recipient_name} — {item.recipient_address}</Text>\n   117→                <Text style={s.preview} numberOfLines={2}>{item.message_preview}</Text>\