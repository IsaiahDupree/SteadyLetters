": \"HTTPS Only API Calls\",\n      \"category\": \"security\",\n      \"description\": \"All API base URLs use https:// protocol (Supabase, Thanks.io, OpenAI)\",\n      \"file\": \"services/thanks-io.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-SEC-006\",\n      \"name\": \"No Mock Data in Production Code\",\n      \"category\": \"security\",\n      \"description\": \"No mock data, fake API responses, or placeholder implementations in production source files\",\n      \"file\": \"services/api.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-PERF-001\",\n      \"name\": \"FlatList for Long Lists\",\n      \"category\": \"performance\",\n      \"description\": \"Recipients, orders, and templates screens use FlatList (not ScrollView) for virtualized rendering\",\n      \"file\": \"app/(tabs)/recipients.tsx\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-PERF-002\",\n      \"name\": \"Memoized List Items\",\n      \"category\": \"performance\",\n      \"description\": \"List item components use React.memo() to prevent unnecessary re-renders\",\n      \"file\": \"app/(tabs)/orders.tsx\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-PERF-003\",\n      \"name\": \"useCallback for Event Handlers\",\n      \"category\": \"performance\",\n      \"description\": \"Event handlers passed to list items wrapped in useCallback to maintain referential stability\",\n      \"file\": \"app/(tabs)/recipients.tsx\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-PERF-004\",\n      \"name\": \"Lazy Loading on Tab Switch\",\n      \"category\": \"performance\",\n      \"description\": \"Tab screens lazy-load their data on focus rather than loading all tabs at once\",\n      \"file\": \"app/(tabs)/orders.tsx\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-001\",\n      \"name\": \"Live Test Configuration\",\n      \"category\": \"testing\",\n      \"description\": \"tests/live/config.ts defines LiveTestConfig with enabled flag, API key, base URL, profiles, default recipient\",\n      \"file\": \"tests/live/config.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-002\",\n      \"name\": \"Live Test Guard\",\n      \"category\": \"testing\",\n      \"description\": \"assertLiveTestEnabled() throws if THANKS_IO_LIVE_TEST is not set or API key is missing\",\n      \"file\": \"tests/live/config.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-003\",\n      \"name\": \"Live Postcard Send Test\",\n      \"category\": \"testing\",\n      \"description\": \"Integration test sends actual postcard via Thanks.io API and verifies success response\",\n      \"file\": \"tests/live/send-postcard.test.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-004\",\n      \"name\": \"Live Letter Send Test\",\n      \"category\": \"testing\",\n      \"description\": \"Integration test sends actual letter via Thanks.io API and verifies success response\",\n      \"file\": \"tests/live/send-letter.test.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-005\",\n      \"name\": \"Live Greeting Card Send Test\",\n      \"category\": \"testing\",\n      \"description\": \"Integration test sends actual greeting card via Thanks.io API and verifies success response\",\n      \"file\": \"tests/live/send-greeting-card.test.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-006\",\n      \"name\": \"Handwriting Styles Fetch Test\",\n      \"category\": \"testing\",\n      \"description\": \"Integration test retrieves handwriting styles from Thanks.io and verifies non-empty array\",\n      \"file\": \"tests/live/send-postcard.test.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-007\",\n      \"name\": \"Order Status Check Test\",\n      \"category\": \"testing\",\n      \"description\": \"Integration test checks order status after sending and verifies valid status response\",\n      \"file\": \"tests/live/send-postcard.test.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-008\",\n      \"name\": \"Jest Configuration\",\n      \"category\": \"testing\",\n      \"description\": \"tests/live/jest.config.ts configures Jest with ts-jest preset for TypeScript test execution\",\n      \"file\": \"tests/live/jest.config.ts\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-009\",\n      \"name\": \"Test Spend Limit Guard\",\n      \"category\": \"testing\",\n      \"description\": \"Live test config enforces maxSpend limit ($15 default) to prevent runaway test costs\",\n      \"file\": \"tests/live/config.ts\",\n      \"passes\": false\n    }\n  ]\n}\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":7,"lines":["   \"platform\": \"ios\",","   \"framework\": \"expo-router\",","   \"version\": \"1.0.0\",","-  \"total_features\": 156,","+  \"total_features\": 184,","   \"categories\": [","     \"auth\",","     \"letter-generation\","]}],"userModified":false,"replaceAll":false}}
