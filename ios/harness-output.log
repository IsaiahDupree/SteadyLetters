{ fontSize: 16, color: colors.text },\n    47→    rowValue: { fontSize: 14, color: colors.textMuted, marginTop: 2 },\n    48→    rowRight: { marginLeft: 8 },\n    49→    themeRow: { flexDirection: 'row', gap: 10, paddingHorizontal: 16, paddingVertical: 12 },\n    50→    themeOption: { flex: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 6, paddingVertical: 10, borderRadius: 10, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border },\n    51→    themeActive: { backgroundColor: colors.primary, borderColor: colors.primary },\n    52→    themeText: { fontSize: 13, fontWeight: '500', color: colors.textSecondary },\n    53→    themeTextActive: { color: '#fff' },\n    54→    signOutRow: { marginTop: 24, marginHorizontal: 16, backgroundColor: colors.errorLight, borderRadius: 12, padding: 16, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 8 },\n    55→    signOutText: { fontSize: 16, fontWeight: '600', color: colors.error },\n    56→  });\n    57→\n    58→  const Row = ({ icon: Icon, label, value, onPress, first }: { icon: typeof User; label: string; value?: string; onPress?: () => void; first?: boolean }) => (\n    59→    <TouchableOpacity style={[s.row, first && s.rowFirst]} onPress={onPress} disabled={!onPress}>\n    60→      <View style={s.rowIcon}><Icon size={20} color={colors.textSecondary} /></View>\n    61→      <View style={s.rowContent}>\n    62→        <Text style={s.rowLabel}>{label}</Text>\n    63→        {value && <Text style={s.rowValue}>{value}</Text>}\n    64→      </View>\n    65→      {onPress && <View style={s.rowRight}><ChevronRight size={18} color={colors.textMuted} /></View>}\n    66→    </TouchableOpacity>\n    67→  );\n    68→\n    69→  return (\n    70→    <ScrollView style={s.container} contentContainerStyle={s.content}>\n    71→      <View style={s.section}>\n    72→        <Text style={s.sectionTitle}>Account</Text>\n    73→        <Row icon={User} label=\"Profile\"