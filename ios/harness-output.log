to-refresh and tap-to-check live status via Thanks.io API\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SETTINGS-001\",\n      \"name\": \"Account Profile Section\",\n      \"description\": \"Display user email, profile info from Supabase\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SETTINGS-002\",\n      \"name\": \"Theme Switcher\",\n      \"description\": \"Light/dark/system theme toggle with persistent preference via SecureStore\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SETTINGS-003\",\n      \"name\": \"Sign Out\",\n      \"description\": \"Sign out with confirmation alert, clear session, redirect to auth\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-NAV-001\",\n      \"name\": \"Tab Navigation\",\n      \"description\": \"5-tab layout: Create, Recipients, Templates, Orders, Settings with icons\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-NAV-002\",\n      \"name\": \"Modal Stack Navigation\",\n      \"description\": \"Send, Voice Recorder, Add Recipient as modal presentations\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-NAV-003\",\n      \"name\": \"Splash Screen\",\n      \"description\": \"Splash screen with auto-hide after layout load\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-001\",\n      \"name\": \"Supabase Client with SecureStore\",\n      \"description\": \"Supabase JS client configured with expo-secure-store for token persistence\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-002\",\n      \"name\": \"Thanks.io API Client\",\n      \"description\": \"Full Thanks.io client: sendPostcard, sendLetter, sendGreetingCard, getHandwritingStyles, getOrderStatus\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-003\",\n      \"name\": \"OpenAI Client\",\n      \"description\": \"GPT-4o letter generation and Whisper audio transcription clients\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-004\",\n      \"name\": \"API CRUD Service\",\n      \"description\": \"Supabase CRUD for recipients, orders, templates, usage tracking\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-TEST-001\",\n      \"name\": \"Live Postcard Send Test\",\n      \"description\": \"Real integration test that sends an actual postcard via Thanks.io API\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-002\",\n      \"name\": \"Live Letter Send Test\",\n      \"description\": \"Real integration test that sends an actual handwritten letter via Thanks.io API\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-003\",\n      \"name\": \"Live Greeting Card Send Test\",\n      \"description\": \"Real integration test that sends an actual greeting card via Thanks.io API\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-004\",\n      \"name\": \"Handwriting Styles API Test\",\n      \"description\": \"Test that retrieves available handwriting styles from Thanks.io\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-005\",\n      \"name\": \"Order Status Check Test\",\n      \"description\": \"Test that checks order status after sending via Thanks.io\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-BILLING-001\",\n      \"name\": \"RevenueCat SDK Setup\",\n      \"description\": \"Initialize RevenueCat with API key, configure offerings\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-BILLING-002\",\n      \"name\": \"Subscription Paywall Screen\",\n      \"description\": \"Display subscription tiers with pricing, purchase flow via RevenueCat\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-BILLING-003\",\n      \"name\": \"Entitlement Checking\",\n      \"description\": \"Check user subscription status, gate premium features\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-ANALYTICS-001\",\n      \"name\": \"PostHog SDK Setup\",\n      \"description\": \"Initialize PostHog React Native SDK, identify users after auth\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-ANALYTICS-002\",\n      \"name\": \"Event Tracking\",\n      \"description\": \"Track letter_created, letter_sent, recipient_added, template_used events\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-NOTIF-001\",\n      \"name\": \"Push Notification Setup\",\n      \"description\": \"Configure expo-notifications, request permissions, register token\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-NOTIF-002\",\n      \"name\": \"Order Status Notifications\",\n      \"description\": \"Send push notifications when order status changes (sent, delivered)\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-001\",\n      \"name\": \"Error Boundary\",\n      \"description\": \"Global error boundary with user-friendly fallback UI\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-002\",\n      \"name\": \"Loading Skeletons\",\n      \"description\": \"Skeleton loading states for lists (recipients, orders, templates)\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-003\",\n      \"name\": \"Haptic Feedback\",\n      \"description\": \"Haptic feedback on button presses and successful actions using expo-haptics\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-004\",\n      \"name\": \"Empty States\",\n      \"description\": \"Polished empty state illustrations for all list screens\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-005\",\n      \"name\": \"Keyboard Avoidance\",\n      \"description\": \"Proper keyboard avoidance on all form screens\",\n      \"passes\": false\n    }\n  ]\n}\n","numLines":273,"startLine":1,"totalLines":273}}}
