{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012R9QowiUHemUfzf2NzV6cW","type":"tool_result","content":"     1→import { supabase } from './supabase';\n     2→import type { Recipient } from './thanks-io';\n     3→\n     4→// -------------------------------------------------------------------\n     5→// Recipients CRUD\n     6→// -------------------------------------------------------------------\n     7→\n     8→export async function getRecipients(): Promise<Recipient[]> {\n     9→  const { data: { user } } = await supabase.auth.getUser();\n    10→  if (!user) throw new Error('Not authenticated');\n    11→\n    12→  const { data, error } = await supabase\n    13→    .from('recipients')\n    14→    .select('*')\n    15→    .eq('user_id', user.id)\n    16→    .order('created_at', { ascending: false });\n    17→\n    18→  if (error) throw error;\n    19→  return data ?? [];\n    20→}\n    21→\n    22→export async function createRecipient(recipient: Omit<Recipient, 'id'>): Promise<Recipient> {\n    23→  const { data: { user } } = await supabase.auth.getUser();\n    24→  if (!user) throw new Error('Not authenticated');\n    25→\n    26→  const { data, error } = await supabase\n    27→    .from('recipients')\n    28→    .insert({ ...recipient, user_id: user.id })\n    29→    .select()\n    30→    .single();\n    31→\n    32→  if (error) throw error;\n    33→  return data;\n    34→}\n    35→\n    36→export async function updateRecipient(id: string, updates: Partial<Recipient>): Promise<Recipient> {\n    37→  const { data, error } = await supabase\n    38→    .from('recipients')\n    39→    .update(updates)\n    40→    .eq('id', id)\n    41→    .select()\n    42→    .single();\n    43→\n    44→  if (error) throw error;\n    45→  return data;\n    46→}\n    47→\n    48→export async function deleteRecipient(id: string): Promise<void> {\n    49→  const { error } = await supabase.from('recipients').delete().eq('id', id);\n    50→  if (error) throw error;\n    51→}\n    52→\n    53→// -------------------------------------------------------------------\n    54→// Orders\n    55→// -------------------------------------------------------------------\n    56→\n    57→export interface Order {\n    58→  id: string;\n    59→  user_id: string;\n    60→  thanks_io_order_id: string;\n    61→  product_type: string;\n    62→  status: string;\n    63→  recipient_name: string;\n    64→  recipient_address: string;\n    65→  message_preview: string;\n    66→  cost: number;\n    67→  created_at: string;\n    68→}\n    69→\n    70→export async function getOrders(): Promise<Order[]> {\n    71→  const { data: { user } } = await supabase.auth.getUser();\n    72→  if (!user) throw new Error('Not authenticated');\n    73→\n    74→  const { data, error } = await supabase\n    75→    .from('orders')\n    76→    .select('*')\n    77→    .eq('user_id', user.id)\n    78→    .order('created_at', { ascending: false });\n    79→\n    80→  if (error) throw error;\n    81→  return data ?? [];\n    82→}\n    83→\n    84→export async function createOrder(order: Omit<Order, 'id' | 'user_id' | 'created_at'>): Promise<Order> {\n    85→  const { data: { user } } = await supabase.auth.getUser();\n    86→  if (!user) throw new Error('Not authenticated');\n    87→\n    88→  const { data, error } = await supabase\n    89→    .from('orders')\n    90→    .insert({ ...order, user_id: user.id })\n    91→    .select()\n    92→    .single();\n    93→\n    94→  if (error) throw error;\n    95→  return data;\n    96→}\n    97→\n    98→// -------------------------------------------------------------------\n    99→// Usage tracking\n   100→// -------------------------------------------------------------------\n   101→\n   102→export interface UsageStats {\n   103→  letterGenerations: number;\n   104→  imageGenerations: number;\n   105→  lettersSent: number;\n   106→  tier: 'free' | 'pro' | 'business';\n   107→}\n   108→\n   109→export async function getUsageStats(): Promise<UsageStats> {\n   110→  const { data: { user } } = await supabase.auth.getUser();\n   111→  if (!user) throw new Error('Not authenticated');\n   112→\n   113→  const { data, error } = await supabase\n   114→    .from('usage')\n   115→    .select('*')\n   116→    .eq('user_id', user.id)\n   117→    .single();\n   118→\n   119→  if (error && error.code !== 'PGRST116') throw error;\n   120→\n   121→  return data ?? {\n   122→    letterGenerations: 0,\n   123→    imageGenerations: 0,\n   124→    lettersSent: 0,\n   125→    tier: 'free',\n   126→  };\n   127→}\n   128→\n   129→export async function incrementUsage(field: 'letter_generations' | 'image_generations' | 'letters_sent'): Promise<void> {\n   130→  const { data: { user } } = await supabase.auth.getUser();\n   131→  if (!user) throw new Error('Not authenticated');\n   132→\n   133→  const { error } = await supabase.rpc('increment_usage', {\n   134→    p_user_id: user.id,\n   135→    p_field: field,\n   136→  });\n   137→\n   138→  if (error) throw error;\n   139→}\n   140→\n   141→// -------------------------------------------------------------------\n   142→// Templates\n   143→// -------------------------------------------------------------------\n   144→\n   145→export interface LetterTemplate {\n   146→  id: string;\n   147→  name: string;\n   148→  occasion: string;\n   149→  tone: string;\n   150→  content: string;\n   151→  is_system: boolean;\n   152→}\n   153→\n   154→export async function getTemplates(): Promise<LetterTemplate[]> {\n   155→  const { data: { user } } = await supabase.auth.getUser();\n   156→\n   157→  const { data, error } = await supabase\n   158→    .from('templates')\n   159→    .select('*')\n   160→    .or(`is_system.eq.true,user_id.eq.${user?.id}`)\n   161→    .order('name');\n   162→\n   163→  if (error) throw error;\n   164→  return data ?? [];\n   165→}\n   166→\n   167→export async function saveTemplate(template: Omit<LetterTemplate, 'id' | 'is_system'>): Promise<LetterTemplate> {\n   168→  const { data: { user } } = await supabase.auth.getUser();\n   169→  if (!user) throw new Error('Not authenticated');\n   170→\n   171→  const { data, error } = await supabase\n   172→    .from('templates')\n   173→    .insert({ ...template, user_id: user.id, is_system: false })\n   174→    .select()\n   175→    .single();\n   176→\n   177→  if (error) throw error;\n   178→  return data;\n   179→}\n   180→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01Ext1m4Q8w3CZiXCCd5Jh2i","session_id":"4dd7b65f-b41a-4d36-961b-3254f3a5b35c","uuid":"39022559-8384-4ab3-88b8-e977f42ad434","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/KindLetters/ios/services/api.ts","content":"import { supabase } from './supabase';\nimport type { Recipient } from './thanks-io';\n\n// -------------------------------------------------------------------\n// Recipients CRUD\n// -------------------------------------------------------------------\n\nexport async function getRecipients(): Promise<Recipient[]> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { data, error } = await supabase\n    .from('recipients')\n    .select('*')\n    .eq('user_id', user.id)\n    .order('created_at', { ascending: false });\n\n  if (error) throw error;\n  return data ?? [];\n}\n\nexport async function createRecipient(recipient: Omit<Recipient, 'id'>): Promise<Recipient> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { data, error } = await supabase\n    .from('recipients')\n    .insert({ ...recipient, user_id: user.id })\n    .select()\n    .single();\n\n  if (error) throw error;\n  return data;\n}\n\nexport async function updateRecipient(id: string, updates: Partial<Recipient>): Promise<Recipient> {\n  const { data, error } = await supabase\n    .from('recipients')\n    .update(updates)\n    .eq('id', id)\n    .select()\n    .single();\n\n  if (error) throw error;\n  return data;\n}\n\nexport async function deleteRecipient(id: string): Promise<void> {\n  const { error } = await supabase.from('recipients').delete().eq('id', id);\n  if (error) throw error;\n}\n\n// -------------------------------------------------------------------\n// Orders\n// -------------------------------------------------------------------\n\nexport interface Order {\n  id: string;\n  user_id: string;\n  thanks_io_order_id: string;\n  product_type: string;\n  status: string;\n  recipient_name: string;\n  recipient_address: string;\n  message_preview: string;\n  cost: number;\n  created_at: string;\n}\n\nexport async function getOrders(): Promise<Order[]> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { data, error } = await supabase\n    .from('orders')\n    .select('*')\n    .eq('user_id', user.id)\n    .order('created_at', { ascending: false });\n\n  if (error) throw error;\n  return data ?? [];\n}\n\nexport async function createOrder(order: Omit<Order, 'id' | 'user_id' | 'created_at'>): Promise<Order> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { data, error } = await supabase\n    .from('orders')\n    .insert({ ...order, user_id: user.id })\n    .select()\n    .single();\n\n  if (error) throw error;\n  return data;\n}\n\n// -------------------------------------------------------------------\n// Usage tracking\n// -------------------------------------------------------------------\n\nexport interface UsageStats {\n  letterGenerations: number;\n  imageGenerations: number;\n  lettersSent: number;\n  tier: 'free' | 'pro' | 'business';\n}\n\nexport async function getUsageStats(): Promise<UsageStats> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { data, error } = await supabase\n    .from('usage')\n    .select('*')\n    .eq('user_id', user.id)\n    .single();\n\n  if (error && error.code !== 'PGRST116') throw error;\n\n  return data ?? {\n    letterGenerations: 0,\n    imageGenerations: 0,\n    lettersSent: 0,\n    tier: 'free',\n  };\n}\n\nexport async function incrementUsage(field: 'letter_generations' | 'image_generations' | 'letters_sent'): Promise<void> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { error } = await supabase.rpc('increment_usage', {\n    p_user_id: user.id,\n    p_field: field,\n  });\n\n  if (error) throw error;\n}\n\n// -------------------------------------------------------------------\n// Templates\n// -------------------------------------------------------------------\n\nexport interface LetterTemplate {\n  id: string;\n  name: string;\n  occasion: string;\n  tone: string;\n  content: string;\n  is_system: boolean;\n}\n\nexport async function getTemplates(): Promise<LetterTemplate[]> {\n  const { data: { user } } = await supabase.auth.getUser();\n\n  const { data, error } = await supabase\n    .from('templates')\n    .select('*')\n    .or(`is_system.eq.true,user_id.eq.${user?.id}`)\n    .order('name');\n\n  if (error) throw error;\n  return data ?? [];\n}\n\nexport async function saveTemplate(template: Omit<LetterTemplate, 'id' | 'is_system'>): Promise<LetterTemplate> {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) throw new Error('Not authenticated');\n\n  const { data, error } = await supabase\n    .from('templates')\n    .insert({ ...template, user_id: user.id, is_system: false })\n    .select()\n    .single();\n\n  if (error) throw error;\n  return data;\n}\n","numLines":180,"startLine":1,"totalLines":180}}}
