      \"description\": \"List item components use React.memo() to prevent unnecessary re-renders\",","+      \"file\": \"app/(tabs)/orders.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-PERF-003\",","+      \"name\": \"useCallback for Event Handlers\",","+      \"category\": \"performance\",","+      \"description\": \"Event handlers passed to list items wrapped in useCallback to maintain referential stability\",","+      \"file\": \"app/(tabs)/recipients.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-PERF-004\",","+      \"name\": \"Lazy Loading on Tab Switch\",","+      \"category\": \"performance\",","+      \"description\": \"Tab screens lazy-load their data on focus rather than loading all tabs at once\",","+      \"file\": \"app/(tabs)/orders.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-001\",","+      \"name\": \"Live Test Configuration\",","+      \"category\": \"testing\",","+      \"description\": \"tests/live/config.ts defines LiveTestConfig with enabled flag, API key, base URL, profiles, default recipient\",","+      \"file\": \"tests/live/config.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-002\",","+      \"name\": \"Live Test Guard\",","+      \"category\": \"testing\",","+      \"description\": \"assertLiveTestEnabled() throws if THANKS_IO_LIVE_TEST is not set or API key is missing\",","+      \"file\": \"tests/live/config.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-003\",","+      \"name\": \"Live Postcard Send Test\",","+      \"category\": \"testing\",","+      \"description\": \"Integration test sends actual postcard via Thanks.io API and verifies success response\",","+      \"file\": \"tests/live/send-postcard.test.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-004\",","+      \"name\": \"Live Letter Send Test\",","+      \"category\": \"testing\",","+      \"description\": \"Integration test sends actual letter via Thanks.io API and verifies success response\",","+      \"file\": \"tests/live/send-letter.test.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-005\",","+      \"name\": \"Live Greeting Card Send Test\",","+      \"category\": \"testing\",","+      \"description\": \"Integration test sends actual greeting card via Thanks.io API and verifies success response\",","+      \"file\": \"tests/live/send-greeting-card.test.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-006\",","+      \"name\": \"Handwriting Styles Fetch Test\",","+      \"category\": \"testing\",","+      \"description\": \"Integration test retrieves handwriting styles from Thanks.io and verifies non-empty array\",","+      \"file\": \"tests/live/send-postcard.test.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-007\",","+      \"name\": \"Order Status Check Test\",","+      \"category\": \"testing\",","+      \"description\": \"Integration test checks order status after sending and verifies valid status response\",","+      \"file\": \"tests/live/send-postcard.test.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-008\",","+      \"name\": \"Jest Configuration\",","+      \"category\": \"testing\",","+      \"description\": \"tests/live/jest.config.ts configures Jest with ts-jest preset for TypeScript test execution\",","+      \"file\": \"tests/live/jest.config.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-TEST-009\",","+      \"name\": \"Test Spend Limit Guard\",","+      \"category\": \"testing\",","+      \"description\": \"Live test config enforces maxSpend limit ($15 default) to prevent runaway test costs\",","+      \"file\": \"tests/live/config.ts\",","+      \"passes\": false","     }","   ]"," }"]}],"originalFile":"{\n  \"project\": \"SteadyLetters iOS\",\n  \"platform\": \"ios\",\n  \"framework\": \"expo-router\",\n  \"version\": \"1.0.0\",\n  \"features\": [\n    {\n      \"id\": \"IOS-AUTH-001\",\n      \"name\": \"Sign In Screen\",\n      \"description\": \"Email/password sign-in with Supabase Auth, error handling, loading state\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-AUTH-002\",\n      \"name\": \"Sign Up Screen\",\n      \"description\": \"Account creation with full name, email, password, confirmation, email verification\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-AUTH-003\",\n      \"name\": \"Forgot Password Screen\",\n      \"description\": \"Password reset via Supabase with email input and reset link\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-AUTH-004\",\n      \"name\": \"Auth Provider with SecureStore\",\n      \"description\": \"React context for auth state with expo-secure-store session persistence\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-AUTH-005\",\n      \"name\": \"Protected Route Guard\",\n      \"description\": \"Redirect unauthenticated users from tabs to sign-in screen\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-LETTER-001\",\n      \"name\": \"AI Letter Generation Screen\",\n      \"description\": \"Generate 3 letter variations with GPT-4o, configurable occasion/tone/key points/recipient context\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-LETTER-002\",\n      \"name\": \"Voice-to-Letter Dictation\",\n      \"description\": \"Record audio via expo-av, transcribe with OpenAI Whisper, use as letter content\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-LETTER-003\",\n      \"name\": \"Letter Template Browser\",\n      \"description\": \"Browse saved templates, filter by occasion/tone, tap to prefill create screen\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SEND-001\",\n      \"name\": \"Send Flow - Product Selection\",\n      \"description\": \"Choose between postcard, letter, greeting card with price display\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SEND-002\",\n      \"name\": \"Send Flow - Recipient Picker\",\n      \"description\": \"Select recipient from address book dropdown with address preview\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SEND-003\",\n      \"name\": \"Send Flow - Handwriting Style\",\n      \"description\": \"Choose handwriting style from Thanks.io styles API\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SEND-004\",\n      \"name\": \"Send Flow - Thanks.io Integration\",\n      \"description\": \"Actually send postcard/letter/greeting card via Thanks.io API, create order record\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-RECIP-001\",\n      \"name\": \"Recipients List with Search\",\n      \"description\": \"Address book with search filter, displaying name/address/city\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-RECIP-002\",\n      \"name\": \"Add Recipient Form\",\n      \"description\": \"Form to add new recipient with name, address, city, state, zip, country\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-RECIP-003\",\n      \"name\": \"Delete Recipient\",\n      \"description\": \"Swipe-to-delete or button with confirmation alert\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-ORDER-001\",\n      \"name\": \"Order History List\",\n      \"description\": \"View past orders with status badges, product type, recipient, cost, date\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-ORDER-002\",\n      \"name\": \"Order Status Refresh\",\n      \"description\": \"Pull-to-refresh and tap-to-check live status via Thanks.io API\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SETTINGS-001\",\n      \"name\": \"Account Profile Section\",\n      \"description\": \"Display user email, profile info from Supabase\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SETTINGS-002\",\n      \"name\": \"Theme Switcher\",\n      \"description\": \"Light/dark/system theme toggle with persistent preference via SecureStore\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SETTINGS-003\",\n      \"name\": \"Sign Out\",\n      \"description\": \"Sign out with confirmation alert, clear session, redirect to auth\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-NAV-001\",\n      \"name\": \"Tab Navigation\",\n      \"description\": \"5-tab layout: Create, Recipients, Templates, Orders, Settings with icons\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-NAV-002\",\n      \"name\": \"Modal Stack Navigation\",\n      \"description\": \"Send, Voice Recorder, Add Recipient as modal presentations\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-NAV-003\",\n      \"name\": \"Splash Screen\",\n      \"description\": \"Splash screen with auto-hide after layout load\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-001\",\n      \"name\": \"Supabase Client with SecureStore\",\n      \"description\": \"Supabase JS client configured with expo-secure-store for token persistence\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-002\",\n      \"name\": \"Thanks.io API Client\",\n      \"description\": \"Full Thanks.io client: sendPostcard, sendLetter, sendGreetingCard, getHandwritingStyles, getOrderStatus\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-003\",\n      \"name\": \"OpenAI Client\",\n      \"description\": \"GPT-4o letter generation and Whisper audio transcription clients\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-SERVICE-004\",\n      \"name\": \"API CRUD Service\",\n      \"description\": \"Supabase CRUD for recipients, orders, templates, usage tracking\",\n      \"passes\": true\n    },\n    {\n      \"id\": \"IOS-TEST-001\",\n      \"name\": \"Live Postcard Send Test\",\n      \"description\": \"Real integration test that sends an actual postcard via Thanks.io API\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-002\",\n      \"name\": \"Live Letter Send Test\",\n      \"description\": \"Real integration test that sends an actual handwritten letter via Thanks.io API\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-003\",\n      \"name\": \"Live Greeting Card Send Test\",\n      \"description\": \"Real integration test that sends an actual greeting card via Thanks.io API\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-004\",\n      \"name\": \"Handwriting Styles API Test\",\n      \"description\": \"Test that retrieves available handwriting styles from Thanks.io\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-TEST-005\",\n      \"name\": \"Order Status Check Test\",\n      \"description\": \"Test that checks order status after sending via Thanks.io\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-BILLING-001\",\n      \"name\": \"RevenueCat SDK Setup\",\n      \"description\": \"Initialize RevenueCat with API key, configure offerings\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-BILLING-002\",\n      \"name\": \"Subscription Paywall Screen\",\n      \"description\": \"Display subscription tiers with pricing, purchase flow via RevenueCat\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-BILLING-003\",\n      \"name\": \"Entitlement Checking\",\n      \"description\": \"Check user subscription status, gate premium features\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-ANALYTICS-001\",\n      \"name\": \"PostHog SDK Setup\",\n      \"description\": \"Initialize PostHog React Native SDK, identify users after auth\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-ANALYTICS-002\",\n      \"name\": \"Event Tracking\",\n      \"description\": \"Track letter_created, letter_sent, recipient_added, template_used events\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-NOTIF-001\",\n      \"name\": \"Push Notification Setup\",\n      \"description\": \"Configure expo-notifications, request permissions, register token\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-NOTIF-002\",\n      \"name\": \"Order Status Notifications\",\n      \"description\": \"Send push notifications when order status changes (sent, delivered)\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-001\",\n      \"name\": \"Error Boundary\",\n      \"description\": \"Global error boundary with user-friendly fallback UI\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-002\",\n      \"name\": \"Loading Skeletons\",\n      \"description\": \"Skeleton loading states for lists (recipients, orders, templates)\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-003\",\n      \"name\": \"Haptic Feedback\",\n      \"description\": \"Haptic feedback on button presses and successful actions using expo-haptics\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-004\",\n      \"name\": \"Empty States\",\n      \"description\": \"Polished empty state illustrations for all list screens\",\n      \"passes\": false\n    },\n    {\n      \"id\": \"IOS-POLISH-005\",\n      \"name\": \"Keyboard Avoidance\",\n      \"description\": \"Proper keyboard avoidance on all form screens\",\n      \"passes\": false\n    }\n  ]\n}\n"}}
