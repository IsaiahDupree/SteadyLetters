 false","+    },","+    {","+      \"id\": \"IOS-POLISH-008\",","+      \"name\": \"Empty State - No Recipients\",","+      \"category\": \"polish\",","+      \"description\": \"Recipients screen shows illustrated empty state with CTA when no recipients exist\",","+      \"file\": \"app/(tabs)/recipients.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-POLISH-009\",","+      \"name\": \"Empty State - No Orders\",","+      \"category\": \"polish\",","+      \"description\": \"Orders screen shows illustrated empty state with CTA when no orders exist\",","+      \"file\": \"app/(tabs)/orders.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-POLISH-010\",","+      \"name\": \"Empty State - No Templates\",","+      \"category\": \"polish\",","+      \"description\": \"Templates screen shows illustrated empty state with CTA when no templates exist\",","+      \"file\": \"app/(tabs)/templates.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-POLISH-011\",","+      \"name\": \"Keyboard Avoidance on Forms\",","+      \"category\": \"polish\",","+      \"description\": \"All form screens (sign-in, sign-up, add-recipient, send) properly avoid keyboard overlap\",","+      \"file\": \"app/add-recipient.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-POLISH-012\",","+      \"name\": \"Keyboard Dismiss on Tap Outside\",","+      \"category\": \"polish\",","+      \"description\": \"Tapping outside text inputs dismisses keyboard on all form screens\",","+      \"file\": \"app/(tabs)/index.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-POLISH-013\",","+      \"name\": \"Pull-to-Refresh on Recipients\",","+      \"category\": \"polish\",","+      \"description\": \"Recipients list supports pull-to-refresh to reload from Supabase\",","+      \"file\": \"app/(tabs)/recipients.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-POLISH-014\",","+      \"name\": \"Pull-to-Refresh on Templates\",","+      \"category\": \"polish\",","+      \"description\": \"Templates list supports pull-to-refresh to reload from Supabase\",","+      \"file\": \"app/(tabs)/templates.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-A11Y-001\",","+      \"name\": \"Screen Reader Labels on Tabs\",","+      \"category\": \"accessibility\",","+      \"description\": \"Tab navigation items have accessibilityLabel for VoiceOver support\",","+      \"file\": \"app/(tabs)/_layout.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-A11Y-002\",","+      \"name\": \"Form Input Labels\",","+      \"category\": \"accessibility\",","+      \"description\": \"All form inputs have accessibilityLabel or associated label text for screen readers\",","+      \"file\": \"app/(auth)/sign-in.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-A11Y-003\",","+      \"name\": \"Button Accessibility Labels\",","+      \"category\": \"accessibility\",","+      \"description\": \"All interactive buttons have accessibilityLabel and accessibilityRole='button'\",","+      \"file\": \"app/send.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-A11Y-004\",","+      \"name\": \"Status Badge Accessibility\",","+      \"category\": \"accessibility\",","+      \"description\": \"Order status badges have accessibilityLabel describing the status (not just color)\",","+      \"file\": \"app/(tabs)/orders.tsx\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-SEC-001\",","+      \"name\": \"No Hardcoded API Keys\",","+      \"category\": \"security\",","+      \"description\": \"No API keys are hardcoded in source files; all use environment variables from config.ts\",","+      \"file\": \"constants/config.ts\",","+      \"passes\": false","+    },","+    {","+      \"id\": \"IOS-SEC-002\",","+      \"name\": \"SecureStore for Tokens\"